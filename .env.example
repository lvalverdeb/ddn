# Copy to `.env`. Compose reads it from this directory without being told to,
# and `make` picks the same names up from your shell — one name per thing,
# whichever way you set it. `make config` prints what is in force.
#
#   cp .env.example .env
#
# `.env` is gitignored: GH_TOKEN belongs in it and must not be committed.

# --- the service -------------------------------------------------------------

# Published port for the API. Used by compose and by `make api` on the host,
# which is the point of it having one name.
DDN_API_PORT=8000

# Image tag shared by the api, worker and tests services, so one build serves
# all three.
DDN_IMAGE=ddn-api:latest

# Where the §13.1 queue lives. Compose overrides this per container
# (redis://redis:6379/0); this value is for host targets like `make api`.
DDN_REDIS_DSN=redis://localhost:6379/0

# --- building ----------------------------------------------------------------

# Read access to github.com/lvalverdeb/osrm-microservice, which the image build
# clones for vrp-platform. An ssh-agent with a key loaded works instead.
#   GH_TOKEN=$(gh auth token)
# GH_TOKEN=

# --- which daemon ------------------------------------------------------------

# Docker's own variables. Unset uses the current context.
# DOCKER_HOST=ssh://ops@buildbox
# DOCKER_CONTEXT=colima

# --- the day-one runner (ddn/simulation/on_road.py) --------------------------

# Not used by compose: `on_road` needs a built gateway with its corpus and a
# built OSRM graph, neither of which is in this repository or in any git
# history, so no service can supply them.
# DDN_PLATFORM_REPO=/path/to/osrm-microservice
# DDN_OSRM_GRAPH=/path/to/costa-rica-latest.osrm
